{
  // Fonte e leitura
  "editor.fontFamily": "'JetBrainsMono Nerd Font', monospace",
  "editor.lineHeight": 24,
  "editor.letterSpacing": 0.2,
  // "editor.fontLigatures": "'ss11'",
  "terminal.integrated.fontFamily": "'JetBrainsMono Nerd Font', monospace",
  "terminal.integrated.fontSize": 14,
  "cSpell.language": "en,pt,pt_BR",
  // Fluxo de edição
  "editor.formatOnSave": false,
  "editor.formatOnSaveMode": "modificationsIfAvailable",
  "files.autoSave": "onFocusChange",
  "files.insertFinalNewline": false,
  "files.trimTrailingWhitespace": false,
  "git.autofetch": false,
  "workbench.editor.enablePreview": false,
  "workbench.startupEditor": "none",
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.cursorBlinking": "smooth",
  // Foco visual
  "editor.minimap.enabled": false,
  "editor.stickyScroll.enabled": false,
  "editor.renderLineHighlight": "gutter",
  "editor.bracketPairColorization.enabled": true,
  "editor.rulers": [80, 120],
  "workbench.colorTheme": "Catppuccin Mocha",
  "workbench.iconTheme": "symbols",
  "workbench.productIconTheme": "fluent-icons",
  "workbench.activityBar.compact": true,
  "workbench.editor.showTabs": "none",
  "explorer.compactFolders": false,
  "editor.guides.indentation": false,
  // Feedback visual opcional
  // Remova este bloco se nao gostar
  "problems.decorations.enabled": true,
  "scm.diffDecorations": "gutter",
  "scm.diffDecorationsGutterVisibility": "always",
  "editor.inlayHints.enabled": "offUnlessPressed",
  // PHP Tools minimo
  // Remova este bloco se nao gostar
  "php.format.codeStyle": "PSR-12",
  "php.codeLens.enabled": false,
  "[blade]": {
    "editor.defaultFormatter": "shufo.vscode-blade-formatter",
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[php]": {
    "editor.defaultFormatter": "junstyle.php-cs-fixer",
  },
  "php-cs-fixer.executablePath": "${extensionPath}/php-cs-fixer.phar",
  "php-cs-fixer.config": "/var/www/html/sigama/.php-cs-fixer.dist.php",
  "workbench.sideBar.location": "left",
  "workbench.activityBar.location": "top",
  "php-cs-fixer.lastDownload": 1776464433203,
}
{
  "workbench.iconTheme": "vscode-icons",
  "editor.fontLigatures": "Fira Code",
  "breadcrumbs.enabled": true,
  "scm.diffDecorations": "none",
  "editor.hover.delay": 1500,
  "editor.hover.enabled": "on",
  "editor.matchBrackets": "never",
  "workbench.tips.enabled": false,
  "editor.colorDecorators": false,
  "git.decorations.enabled": false,
  "workbench.startupEditor": "none",
  "editor.lightbulb.enabled": "off",
  "editor.selectionHighlight": false,
  "editor.overviewRulerBorder": false,
  "editor.renderLineHighlight": "none",
  "editor.occurrencesHighlight": "off",
  "problems.decorations.enabled": false,
  "editor.renderControlCharacters": false,
  "editor.hideCursorInOverviewRuler": true,
  "editor.gotoLocation.multipleReferences": "goto",
  "editor.gotoLocation.multipleDefinitions": "goto",
  "editor.gotoLocation.multipleDeclarations": "goto",
  "workbench.editor.enablePreviewFromQuickOpen": false,
  "editor.gotoLocation.multipleImplementations": "goto",
  "editor.gotoLocation.multipleTypeDefinitions": "goto",

  "editor.copyWithSyntaxHighlighting": false,
  "diffEditor.ignoreTrimWhitespace": false,
  "editor.emptySelectionClipboard": false,
  "workbench.editor.enablePreview": false,
  "window.newWindowDimensions": "inherit",
  "files.trimTrailingWhitespace": true,
  "diffEditor.renderSideBySide": false,
  "editor.snippetSuggestions": "top",
  "editor.detectIndentation": false,
  "window.nativeFullScreen": true,
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,

  "search.exclude": {
    "**/vendor/{[^l],?[^ai]}*": true,
    "**/public/{[^i],?[^n]}*": true,
    "**/node_modules": true,
    "**/dist": true,
    "**/_ide_helper.php": true,
    "**/composer.lock": true,
    "**/package-lock.json": true,
    "storage": true,
    ".phpunit.result.cache": true
  },

  "[html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "prettier.singleQuote": true,
  "editor.formatOnSave": true,
  "editor.fontWeight": 500,
  "editor.minimap.enabled": false,

  "eslint.lintTask.enable": true,
  "eslint.workingDirectories": [{ "mode": "auto" }],
  "editor.wordWrap": "on",
  "emmet.excludeLanguages": ["markdown"],
  "emmet.preferences": {},

  "autoprefixer.options": {
    "browsers": ["last 4 versions", "ie >= 9", "> 5%"]
  },
  "autoprefixer.formatOnSave": true,
  "editor.suggestSelection": "first",
  "vsintellicode.modify.editor.suggestSelection": "automaticallyOverrodeDefaultValue",
  "terminal.integrated.fontSize": 13,
  "editor.linkedEditing": true,
  "open-in-browser.default": "chrome",
  "emmet.includeLanguages": { "javascript": "javascriptreact" },

  "editor.tokenColorCustomizations": {
    "textMateRules": [
      {
        "name": "storage.type.class.jsdoc",
        "scope": "storage.type.class.jsdoc,entity.name.type.instance.jsdoc,variable.other.jsdoc",
        "settings": {
          "foreground": "#7f848eff"
        }
      },
      {
        "scope": "support.type.property-name.css",
        "settings": {
          "foreground": "#03c003"
        }
      },
      {
        "scope": "meta.property-value.css",
        "settings": {
          "foreground": "#00a2ff"
        }
      }
    ]
  },
  "editor.cursorSmoothCaretAnimation": "on",
  "workbench.list.openMode": "doubleClick",
  "eslint.alwaysShowStatus": true,
  "eslint.format.enable": true,
  "eslint.debug": true,
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[tailwindcss]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[vue]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "editor.multiCursorModifier": "ctrlCmd",
  "mongosnippets": {
    "sourceDir": "backend"
  },

  "[css]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },

  "editor.quickSuggestions": {
    "strings": true
  },
  "[json]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },

  "security.workspace.trust.untrustedFiles": "open",
  "diffEditor.wordWrap": "on",
  "notebook.output.wordWrap": true,
  "editor.minimap.maxColumn": 250,
  "codesnap.containerPadding": "8em",
  "codesnap.boxShadow": "rgba(0, 0, 0, 0.55) 0px 12px 24px",
  "explorer.confirmDelete": false,
  "editor.accessibilitySupport": "off",
  "chat.editor.wordWrap": "on",
  "code-runner.executorMap": {
    "javascript": "/home/mozahedul/.nvm/versions/node/v14.17.5/bin/node"
  },
  "code-runner.runInTerminal": true,
  "code-runner.clearPreviousOutput": true,
  "editor.cursorBlinking": "smooth",
  "debug.allowBreakpointsEverywhere": true,
  "debug.console.acceptSuggestionOnEnter": "on",
  "editor.bracketPairColorization.enabled": true,
  "debug.javascript.debugByLinkOptions": "always",
  "debug.terminal.clearBeforeReusing": true,
  "prettier.trailingComma": "none",
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "always"
  },
  "js/ts.implicitProjectConfig.checkJs": true,
  "files.exclude": {
    "**/.eslintignore": true,
    "**/.prettierignore": true,
    "**/.prettierrc": true,
    "**/package-lock.json": true
  },
  "files.watcherExclude": {
    "**/.eslintignore": true,
    "**/.prettierignore": true,
    "**/.prettierrc": true,
    "**/package-lock.json": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/CVS": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true
  },
  "cSpell.userWords": [
    "antd",
    "appspot",
    "Appstore",
    "authtoken",
    "cloudinary",
    "datepicker",
    "ecommerce",
    "firebaseapp",
    "maxlength",
    "Middlewares",
    "mozahed",
    "Mozahedul",
    "placeorder",
    "resizer",
    "toastify",
    "todos",
    "uniqueid"
  ],
  "better-comments.multilineComments": true,
  "js/ts.validate.enable": false,
  "files.autoSave": "afterDelay",
  "files.autoSaveDelay": 3000,
  "editor.tabSize": 2,
  "debug.openDebug": "openOnFirstSessionStart",
  "debug.showInStatusBar": "never",
  "editor.fontSize": 13,
  "editor.fontFamily": "'Geist Mono','JetBrains Mono','Fira Code','Droid Sans Mono', 'monospace', monospace, 'Droid Sans Fallback'",
  "editor.suggestFontSize": 13,
  "editor.suggestLineHeight": 24,
  "terminal.integrated.lineHeight": 1.2,
  "search.useIgnoreFiles": false,
  "git.autorefresh": false,
  "gitlens.views.repositories.autoRefresh": false,
  "java.dependency.autoRefresh": false,
  "terminal.integrated.enableShellIntegration": true,
  "importCost.timeout": 50000,
  "JSON-zain.json.autorefresh": true,
  "js/ts.updateImportsOnFileMove.enabled": "never",
  "workbench.settings.applyToAllProfiles": [],
  "workbench.colorTheme": "GitHub Dark Default",
  "tailwindCSS.experimental.configFile": null,
  "workbench.activityBar.location": "default",
  "workbench.statusBar.visible": true,
  "editor.inlineSuggest.suppressSuggestions": true,
  "codesnap.backgroundColor": "#FFC540",
  "codesnap.showLineNumbers": false,
  "codesnap.roundedCorners": true,
  "editor.padding.top": 16,
  "editor.stickyScroll.enabled": false,
  "editor.lineHeight": 22,
  "editor.mouseWheelZoom": true,
  "chat.editor.fontSize": 13,
  "debug.console.fontSize": 13
}
